server {
  listen __RYX_LISTEN__;
  server_name __RYX_SERVER_NAME__ h5.songguoren.site web.songguoren.site;

  index index.html;
  client_max_body_size 20m;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

  set $ryx_default_entry h5;
  if ($host = web.songguoren.site) {
    set $ryx_default_entry web;
  }

  location = / {
    return 302 /$ryx_default_entry/$is_args$args;
  }

  location = /h5 {
    return 301 /h5/;
  }

  location = /web {
    return 301 /web/;
  }

  location ^~ /h5/assets/ {
    alias __RYX_INSTALL_DIR__/h5/dist/assets/;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  location ^~ /web/assets/ {
    alias __RYX_INSTALL_DIR__/web/dist/assets/;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  location ^~ /h5/ {
    alias __RYX_INSTALL_DIR__/h5/dist/;
    try_files $uri $uri/ /h5/index.html;
  }

  location ^~ /web/ {
    alias __RYX_INSTALL_DIR__/web/dist/;
    try_files $uri $uri/ /web/index.html;
  }

  location ^~ /Home/ {
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://app.rtesp.com;
  }

  location ^~ /Jyx/ {
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
