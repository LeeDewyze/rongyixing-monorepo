FROM node:20-alpine AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY . .

ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
ARG VITE_APP_ID=com.ronglvonline.app
ARG VITE_API_MODE=proxy
ARG VITE_API_BASE_URL=
ARG VITE_API_DOMAIN=rtesp.com
ARG VITE_BASE_PATH=/

ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}
ENV npm_config_registry=${NPM_CONFIG_REGISTRY}
ENV VITE_APP_ID=${VITE_APP_ID}
ENV VITE_API_MODE=${VITE_API_MODE}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_API_DOMAIN=${VITE_API_DOMAIN}
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

RUN pnpm config set registry "${NPM_CONFIG_REGISTRY}" \
  && pnpm config set fetch-retries 5 \
  && pnpm config set fetch-retry-maxtimeout 120000 \
  && pnpm config set fetch-timeout 300000
RUN pnpm install --frozen-lockfile
RUN pnpm build:workspace
RUN pnpm --filter @ryx/web build

FROM nginx:1.27-alpine AS runtime

COPY deploy/nginx/h5.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
