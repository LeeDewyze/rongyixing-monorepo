FROM node:20-alpine AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY . .

ARG VITE_APP_ID=com.ronglvonline.app
ARG VITE_API_MODE=proxy
ARG VITE_API_BASE_URL=
ARG VITE_API_DOMAIN=rtesp.com

ENV VITE_APP_ID=${VITE_APP_ID}
ENV VITE_API_MODE=${VITE_API_MODE}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_API_DOMAIN=${VITE_API_DOMAIN}

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ryx/h5 build

FROM nginx:1.27-alpine AS runtime

COPY deploy/nginx/h5.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/h5/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
